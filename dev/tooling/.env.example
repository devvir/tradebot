# Environment overrides for tooling (runs on host, not inside Docker)

# Infrastructure
# Broker URL, used when no running rabbitmq container is found.
# QUEUE_URL=

# ===== cold =====
# Every variable cold reads, with its default: docs/tooling/COLD.md#configuration.
# DATA_DIR, DATA_ARCHIVES_DIR and DATA_VAULT_DIR come from the root .env, and
# CATALOG_DIR from there or else from modules/collect/archives/.env; set one here
# only to override it for the tooling.

# Where this project's trees live in Mega (required).
MEGA_ROOT=/Tradebot

# Cold's own directory: the record, staging tars, locks. Default: ${DATA_DIR}/@cold
SOURCES_COLD_DIR=${DATA_DIR}/@cold

# GB still queued for upload before push packs and hands over nothing more.
COLD_QUEUE_TARGET_GB=10

# Hours a settled partition must also have gone unchanged in the catalog before
# it is stored. Unset, settled is enough.
# COLD_SETTLED_HOURS=24

# The tooling runs on the host, outside the docker network, so it needs the
# catalog on a known host port. Unset, CATALOG_URL is
# http://localhost:<CATALOG_PORT from modules/collect/archives/.env>, or
# http://localhost:9010 where that file does not set CATALOG_PORT. An empty
# CATALOG_PORT publishes the catalog on a port docker picks, which this cannot
# find, so cold refuses to ask the catalog until CATALOG_PORT in the archives
# module or CATALOG_URL here is set.
# CATALOG_URL=http://localhost:9010
# Unset, the archives module's CATALOG_TOKEN.
# CATALOG_TOKEN=
