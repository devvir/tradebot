# Environment overrides for tooling (runs on host, not inside Docker)

# Infrastructure
QUEUE_URL=
BOUNCER_URL=

# Command: data — BitMEX vault
SOURCES_REMOTE_VAULTS=
SOURCES_MEGA_VAULT=

# Where this project's trees live in Mega.
MEGA_ROOT=/Tradebot

SOURCES_COLD_DIR=${DATA_DIR}/@cold
ARCHIVES_DIR=${DATA_DIR}/archives
VAULT_DIR=${DATA_DIR}/vault

# GB still queued for upload before packing pauses
COLD_QUEUE_TARGET_GB=10
