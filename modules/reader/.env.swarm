# Reader Module Configuration - Docker Swarm Scaling Example
#
# Use this configuration to deploy with horizontal scaling:
#   docker stack deploy -c modules/reader/compose.yml reader
#
# Copy values from .env and override REPLICAS values below

# ===== Module =====
# COMPOSE_PROJECT_NAME=reader

# ===== Feed Service =====
FEED_CHANNELS=*
FEED_SYMBOLS=XBTUSD
# FEED_PORT=  # Leave empty in swarm - ports not exposed externally for feed
FEED_REPLICAS=1
# FEED_RECONNECT_DELAY_MS=5000
# FEED_MAX_RECONNECT_DELAY_MS=60000
# FEED_MESSAGE_TTL=1800000

# ===== Codec Service (Scaled) =====
# CODEC_BATCH_SIZE=100
# CODEC_BATCH_TIMEOUT_MS=5000
# CODEC_PORT=  # Leave empty in swarm - internal service
CODEC_REPLICAS=3  # Scale to 3 instances consuming from shared queue
# CODEC_RESTART_POLICY=unless-stopped

# ===== Archivist Service (Scaled) =====
# ARCHIVIST_BATCH_SIZE=100
# ARCHIVIST_BATCH_TIMEOUT_MS=5000
# ARCHIVIST_PORT=  # Leave empty in swarm - internal service
ARCHIVIST_REPLICAS=2  # Scale to 2 instances
# ARCHIVIST_RESTART_POLICY=unless-stopped

# ===== RabbitMQ (Message Queue) =====
RABBITMQ_USER=readerqueue
RABBITMQ_PASS=duq90wdi43uds
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASS}@rabbitmq:5672
RABBITMQ_AMQP_PORT=9672
RABBITMQ_MGMT_PORT=19672

# ===== MongoDB (Persistence) =====
MONGODB_USER=readerdb
MONGODB_PASS=udsa09djd
MONGODB_URL=mongodb://${MONGODB_USER}:${MONGODB_PASS}@mongodb:27017/tradebot?authSource=admin
MONGODB_PORT=27018
MONGODB_CACHE_SIZE_GB=4
