# Reader Module Configuration
# Copy this file to .env and update all credentials!

# ===== Compose Project =====
MODULE_NAME=tradebot                        # Default: tradebot (sets non-shared services' container name prefix)

# ===== Service Scaling =====
FEED_REPLICAS=1                             # Default: 1 (number of instances for horizontal scaling in Swarm)
CODEC_REPLICAS=1                            # Default: 1 (number of instances for horizontal scaling in Swarm)
ARCHIVIST_REPLICAS=1                        # Default: 1 (number of instances for horizontal scaling in Swarm)

# ===== Feed Service =====
FEED_PORT=                                  # Default: <empty> (random port)
FEED_RECONNECT_DELAY_MS=5000                # Default: 5000 (initial reconnection delay to Bitmex WS)
FEED_MAX_RECONNECT_DELAY_MS=60000           # Default: 60000 (max reconnection delay to Bitmex WS)
FEED_MESSAGE_TTL=1800000                    # Default: 1800000 (30 minutes in ms) (queue TTL for feed messages)
FEED_RESTART_POLICY=unless-stopped          # Default: unless-stopped

# ===== Codec Service =====
CODEC_STRATEGY=                             # Default: <empty> (optional, comma-separated: trim, binary)
CODEC_PORT=                                 # Default: <empty> (random available port)
CODEC_RESTART_POLICY=unless-stopped         # Default: unless-stopped

# ===== Archivist Service =====
ARCHIVIST_BATCH_SIZE=1000                   # Default: 1000 (batch size to consume from rabbitmq)
ARCHIVIST_BATCH_TIMEOUT_MS=5000             # Default: 5000 (timeout for consuming from rabbitmq)
ARCHIVIST_PORT=                             # Default: <empty> (random available port)
ARCHIVIST_RESTART_POLICY=unless-stopped     # Default: unless-stopped
