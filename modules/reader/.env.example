# Reader Module Configuration
# Copy this file to .env and update all credentials!

# ===== Module =====
COMPOSE_PROJECT_NAME=reader                 # Default: reader

# ===== BitMEX Feed Service =====
FEED_CHANNELS=trade,orderBookL2             # Default: trade,orderBookL2_25
FEED_SYMBOLS=XBTUSD,ETHUSD                  # Default: XBTUSD
FEED_PORT=3001                              # Default: 3001
FEED_RECONNECT_DELAY_MS=5000                # Default: 5000
FEED_MAX_RECONNECT_DELAY_MS=60000           # Default: 60000
FEED_MESSAGE_TTL=1800000                    # Default: 1800000 (30 minutes in ms)

# ===== Archivist Service =====
ARCHIVIST_BATCH_SIZE=100                    # Default: 100
ARCHIVIST_BATCH_TIMEOUT_MS=5000             # Default: 5000
ARCHIVIST_PORT=3002                         # Default: 3002

# ===== RabbitMQ (Message Queue) =====
RABBITMQ_AMQP_PORT=9672                     # Default: 9672
RABBITMQ_MGMT_PORT=19672                    # Default: 19672
RABBITMQ_RESTART_POLICY=unless-stopped      # Default: unless-stopped
# ⚠️  CRITICAL: CHANGE THESE! RabbitMQ exposes your queue to the network.
RABBITMQ_USER=CHANGE_ME                     # Default: guest
RABBITMQ_PASS=CHANGE_ME                     # Default: guest

# ===== MongoDB (Persistence) =====
MONGODB_PORT=27018                          # Default: 27018 (to avoid conflicts with local MongoDB)
MONGODB_RESTART_POLICY=unless-stopped       # Default: unless-stopped
# ⚠️  CRITICAL: CHANGE THESE! MongoDB requires authentication.
MONGODB_USER=CHANGE_ME                      # Default: root
MONGODB_PASS=CHANGE_ME                      # Default: password
