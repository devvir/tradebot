# ===== UI Service =====
UI_PORT=3000                                              # Browser-facing port

# REST proxy (CORS bypass) for the live/testnet environments → the proxy service.
UI_REST_PROXY=http://proxy                                # default: http://proxy

# ===== Replay (digger) — enables the "Replay" environment =====
# Set the host where digger's mapped ports are reachable (e.g. localhost for a
# local replay module, or the docker host). Leave empty to hide Replay.
UI_DIGGER_HOST=                                           # e.g. localhost
UI_DIGGER_WS_PORT=8180                                    # digger ws  (DIGGER_WS_PORT)
UI_DIGGER_REST_PORT=3101                                  # digger rest (DIGGER_REST_PORT)
UI_DIGGER_CONTROL_PORT=8280                               # digger control (DIGGER_CONTROL_PORT)
