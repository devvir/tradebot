# Farm Module Configuration
# Copy this file to .env and update with your values.

# ===== Infrastructure =====
DB_URL=${DB_STORE_URL}

# ===== Vault =====
VAULT_URL=http://harvester:8000             # Read-only vault replica pool (see compose.yml)

# ===== Writer Service =====
WRITER_REPLICAS=1                           # Number of Writer replicas (see compose.yml)
WRITER_IGNORE_DUPLICATES=true               # Whether to ignore duplicate key errors from MongoDB (true/false)

# ===== Farmer Service =====
FARMER_TABLES=                              # Default: <empty> Comma-separated list of tables (empty = all)
FARMER_FILE_CONCURRENCY=10                  # Default: 10 (parallel reader workers)
FARMER_READ_BUFFER_HIGH=1000000             # Default: 1000000 (reader queue high watermark)
FARMER_READ_BUFFER_LOW=500000               # Default: 500000 (reader queue low watermark)
FARMER_INFLIGHT_CAP=500000                  # Default: 500000 (global in-flight items cap)
FARMER_WIRE_CAP_MB=20                       # Default: 20 (max batch size to send to Writer at once, in megabytes)
FARMER_FLUSH_INTERVAL_MS=100                # Default: 100 (per-table batch flush timer)
FARMER_PROGRESS_INTERVAL_MS=1000            # Default: 1000 (per-task Redis progress tick)
FARMER_METRICS_INTERVAL_MS=60000            # Default: 60000 (throughput metrics log interval)

# ===== Distiller Service =====
DISTILLER_DISTILLERS=                       # Default: <empty> (run all). Comma-separated subset: quote,trade,orderbook,instrument,partials
