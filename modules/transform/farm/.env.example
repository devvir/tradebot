# Farm Module Configuration
# Copy this file to .env and update with your values.

# ===== Harvester (vault instances)=====
HARVESTER_REPLICAS=2                        # Number of vault replicas (owned by farm as harvester)
HARVESTER_URL=                              # URL for the farm-owned vault replica pool

# ===== Writer (librarian instances) =====
WRITER_REPLICAS=2                           # Number of librarian replicas (owned by farm as writer)
WRITER_URL=http://writer                    # URL for the farm-owned librarian replica pool

# ===== Farmer Service =====
FARMER_TABLES=                              # Default: <empty> Comma-separated list of tables (empty = all)
FARMER_INFLIGHT_CAP=20                      # Default: 20 (max concurrent POSTs in flight to writer)
FARMER_FILE_CONCURRENCY=10                  # Default: 10 (parallel reader workers)
FARMER_FLUSH_INTERVAL_MS=100                # Default: 100 (per-table batch flush timer)

# ===== Distiller Service =====
DISTILLER_DISTILLERS=                       # Default: <empty> (run all). Comma-separated subset: quote,trade,orderbook,instrument,partials
