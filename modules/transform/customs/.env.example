# Customs Module Configuration
# Copy this file to .env and update with your values.

# ===== Infrastructure =====
DB_URL=${DB_STORE_URL}

# ===== Clerk Service =====
CLERK_TABLES=                               # Default: <empty> (process all tables). Comma-separated list of vault table names.
CLERK_BACKPRESSURE_LIMIT=100000             # Default: 100000 (pause at ×1.1, resume at ×0.9)
CLERK_WATCH_QUEUES=                         # Default: <empty>

# ===== Assembler Service =====
ASSEMBLER_PREFETCH=200                      # Default: 200 (RabbitMQ prefetch per consumer)

# ===== Registrar Service =====
REGISTRAR_PREFETCH=500                      # Default: 500 (RabbitMQ prefetch per consumer)
REGISTRAR_FLUSH_INTERVAL_MS=50              # Default: 50 (max ms to hold a partial batch)

# ===== Distiller Service =====
DISTILLER_GENERATORS=                       # Default: <empty> (run all). Comma-separated subset: quote,trade,orderbook,instrument,partials
