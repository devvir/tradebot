# Extract Module Configuration
# Copy this file to .env and update all credentials!

# ===== Compose Project =====
MODULE_NAME=tradebot                        # Default: tradebot (sets non-shared services' container name prefix)

# ===== Service Scaling =====
ARCHIVIST_REPLICAS=1                        # Default: 1 (number of instances for horizontal scaling in Swarm)
UNARCHIVIST_REPLICAS=1                      # Default: 1 (number of instances for horizontal scaling in Swarm)
CODEC_REPLICAS=1                            # Default: 1 (number of instances for horizontal scaling in Swarm)

# ===== Archivist Service =====
ARCHIVIST_DATABASE=                         # Default: <empty> (Required: MongoDB database to write decoded data to)
ARCHIVIST_EXCHANGE=ex.archive               # Default: ex.archive (topic exchange archivist consumes from)
ARCHIVIST_QUEUE=q.archive                   # Default: q.archive (subscribed to the all ARCHIVIST_EXCHANGE topics)
ARCHIVIST_BATCH_SIZE=1000                   # Default: 1000 (batch size to consume from rabbitmq)
ARCHIVIST_BATCH_TIMEOUT_MS=5000             # Default: 5000 (timeout for consuming from rabbitmq)
ARCHIVIST_PORT=                             # Default: <empty> (random available port)
ARCHIVIST_RESTART_POLICY=unless-stopped     # Default: unless-stopped

# ===== Unarchivist Service =====
UNARCHIVIST_DATABASE=tradebot_archive       # Default: tradebot_archive (MongoDB database to read encoded data from)
UNARCHIVIST_COLLECTIONS=                    # Default: <empty> (all collections; comma-separated whitelist)
UNARCHIVIST_EXCHANGE=ex.transform           # Default: ex.transform (topic exchange unarchivist publishes to)
UNARCHIVIST_QUEUE=q.transform               # Default: q.transform (subscribed to the all UNARCHIVIST_EXCHANGE topics)
UNARCHIVIST_BATCH_SIZE=1000                 # Default: 1000 (batch size for scanning MongoDB)
UNARCHIVIST_POLL_INTERVAL_MS=3000           # Default: 3000 (interval from completion to next iteration)
UNARCHIVIST_PORT=                           # Default: <empty> (random available port)
UNARCHIVIST_RESTART_POLICY=unless-stopped   # Default: unless-stopped

# ===== Codec Service =====
CODEC_INBOUND_EXCHANGE=ex.feed              # Default: ex.feed
CODEC_INBOUND_QUEUE=q.feed                  # Default: q.feed
CODEC_OUTBOUND_EXCHANGE=ex.archive          # Default: ex.archive
CODEC_OUTBOUND_QUEUE=q.archive              # Default: q.archive
CODEC_STRATEGY=                             # Default: <empty> (optional, comma-separated: encode, binary)
CODEC_PREFETCH=100                          # Default: 100 (number of messages buffered from queue)
CODEC_BROTLI_QUALITY=4                      # Default: 4 (compression quality 0-11: 0=fastest, 11=best compression)
CODEC_PORT=                                 # Default: <empty> (random available port)
CODEC_RESTART_POLICY=unless-stopped         # Default: unless-stopped
