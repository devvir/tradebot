# Warehouse Module Configuration
# Copy this file to .env and set the catalog token.

# ===== Storage =====
# The archives (mounted READ-ONLY) and the vault are the root .env's
# DATA_ARCHIVES_DIR and DATA_VAULT_DIR; set either here only to move it for
# this module alone.

# ===== Catalog =====
# Default: http://catalog:8080, inside the shared network.
CATALOG_API=http://catalog:8080
# The catalog's shared secret; empty where it has none.
CATALOG_TOKEN=

# ===== Stocker Service =====
# Default: <empty> (the whole catalog). The lens it is read through.
STOCKER_LENS=
# Default: <empty> (all). CSV of: binance,bitget,bybit,gate,htx,kucoin,okx
STOCKER_VENUES=
# Default: 4. Query engine threads.
STOCKER_THREADS=4
# Default: 2. Builds at once, one instrument each; each holds a month-sized sort.
STOCKER_CONCURRENCY=2
# Default: 20. No partition is started below this much free space on the vault
# volume.
STOCKER_MIN_FREE_GB=20
# Default: 4. Memory the query engine may use before it spills to disk.
STOCKER_ENGINE_MEMORY_GB=4
