# Warehouse Module Configuration
# Copy this file to .env and set the two directories.

# ===== Storage =====
# Trucker's archive directory, mounted READ-ONLY. Must match TRUCKER_DATA_DIR in
# the collect module — the same host path is named in both, so repoint both when
# storage moves.
TRUCKER_DATA_DIR=                           # REQUIRED. Host dir holding the raw archives
STOCKER_VAULT_DIR=                          # REQUIRED. Host dir for the Parquet vault; pre-create owned by uid 1000

# ===== Stocker Service =====
STOCKER_VENUES=                             # Default: <empty> (all). CSV of: binance,bitget,bybit,gate,htx,kucoin,okx
STOCKER_TABLES=                             # Default: <empty> (all). CSV of canonical tables: trades,klines,quotes,funding,…
STOCKER_SYMBOLS=                            # Default: <empty> (every symbol). Case-insensitive substrings
STOCKER_START_MONTH=                        # Default: <empty> (no floor). Oldest month to process, INCLUSIVE. yyyy-mm, yyyymm or yymm
STOCKER_END_MONTH=                          # Default: <empty> (no ceiling). Newest month to process, INCLUSIVE — hold below the era still being collected
STOCKER_CONCURRENCY=2                       # Default: 2. Partitions built at once; each holds a month-sized sort
STOCKER_SCAN_MINUTES=30                     # Default: 30. Minutes between rescans of the raw tree
STOCKER_MEMORY_MB=4096                      # Default: 4096. Node heap for the service, in MB
STOCKER_THREADS=4                           # Default: 4. Query engine threads
