# Warehouse Module Configuration
# Copy this file to .env and set the catalog token.

# ===== Storage =====
# The archives (mounted READ-ONLY) and the vault are DATA_ARCHIVES_DIR and
# DATA_VAULT_DIR, by default under the root .env's DATA_DIR; set either here
# only to move it for this module alone.

# ===== Catalog =====
# Default: http://catalog:8080, inside the shared network.
CATALOG_API=http://catalog:8080
# The catalog's shared secret; empty where it has none.
CATALOG_TOKEN=

# ===== Stocker Service =====
# Default: <empty> (the whole catalog). The lens it is read through.
STOCKER_LENS=
# Default: <empty> (all). CSV of: binance,bitget,bybit,gate,htx,kucoin,okx
STOCKER_VENUES=
# Default: 4. Threads the query engine may use, shared by every build.
STOCKER_THREADS=4
# Default: 2. DuckDB connections, one pool shared by partitions: as many light
# partitions built side by side, or one heavy partition's tasks. Each holds a
# month-sized sort.
STOCKER_CONCURRENCY=2
# Default: 20. Free space kept on the vault's volume: below it a sweep stops,
# and the engine's spill is capped at what is free above it.
STOCKER_MIN_FREE_GB=20
# Default: 4. Memory the query engine may use, shared by every build, before it
# spills to disk.
STOCKER_ENGINE_MEMORY_GB=4
