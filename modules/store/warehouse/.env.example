# Warehouse Module Configuration
# Copy this file to .env and set the directories and the catalog token.

# ===== Storage =====
# The archives, mounted READ-ONLY. The same host path as HAULER_ARCHIVES_DIR in
# the archives module — repoint both together when storage moves.
STOCKER_ARCHIVES_DIR=                       # REQUIRED. Host dir holding the archives
STOCKER_VAULT_DIR=                          # REQUIRED. Host dir for the Parquet vault; pre-create owned by uid 1000

# ===== Catalog =====
CATALOG_API=http://catalog:8080             # Default: http://catalog:8080, inside the shared network
CATALOG_TOKEN=                              # The catalog's shared secret; empty where it has none
STOCKER_LENS=                               # Default: <empty> (the whole catalog). The lens it is read through

# ===== Stocker Service =====
STOCKER_VENUES=                             # Default: <empty> (all). CSV of: binance,bitget,bybit,gate,htx,kucoin,okx
STOCKER_TABLES=                             # Default: <empty> (all). CSV of canonical tables: trades,klines,quotes,funding,…
STOCKER_SYMBOLS=                            # Default: <empty> (every symbol). Case-insensitive substrings
STOCKER_START_MONTH=                        # Default: <empty> (no floor). Oldest month to stock, INCLUSIVE. yyyy-mm, yyyymm or yymm
STOCKER_END_MONTH=                          # Default: <empty> (no ceiling). Newest month to stock, INCLUSIVE
STOCKER_CONCURRENCY=2                       # Default: 2. Builds at once, one instrument each; each holds a month-sized sort
STOCKER_SCAN_MINUTES=30                     # Default: 30. Minutes between sweeps
STOCKER_MEMORY_MB=4096                      # Default: 4096. Node heap for the service, in MB
STOCKER_THREADS=4                           # Default: 4. Query engine threads
STOCKER_MIN_FREE_GB=20                      # Default: 20. No partition is started below this much free space on the vault volume
