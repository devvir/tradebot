# Archivist Module Configuration
# Copy this file to .env and update all credentials!

# ===== Infrastructure =====
DB_URL=${DB_FEED_URL}
QUEUE_URL=${QUEUE_RT_URL}

# ===== Broadcast Service =====
BROADCAST_FEED_PRESET=feed                  # Default: feed (all public channels - feed|archive|primary|secondary|redundant)
BROADCAST_RECONNECT_DELAY_MS=5000           # Default: 5000 (initial reconnection delay to Bitmex WS)
BROADCAST_MAX_RECONNECT_DELAY_MS=60000      # Default: 60000 (max reconnection delay to Bitmex WS)
BROADCAST_MESSAGE_TTL=1800000               # Default: 1800000 (30 minutes in ms) (queue TTL for broadcast messages)
BROADCAST_PORT=                             # Default: <empty> (random port)
BROADCAST_RESTART_POLICY=unless-stopped     # Default: unless-stopped

# ===== Codec Service =====
CODEC_PREFETCH=1000                         # Default: 1000 (number of messages buffered from queue)
CODEC_BROTLI_QUALITY=1                      # Default: 1 (compression quality 0-11: 0=fastest, 11=best compression)
CODEC_PORT=                                 # Default: <empty> (random available port)
CODEC_RESTART_POLICY=unless-stopped         # Default: unless-stopped

# ===== Writer Service =====
WRITER_PREFETCH=1000                        # Default: 1000 (RabbitMQ prefetch window per consumer)
WRITER_FLUSH_INTERVAL_MS=50                 # Default: 50 (max ms to hold a partial batch before flushing)
WRITER_PORT=                                # Default: <empty> (random available port)
WRITER_RESTART_POLICY=unless-stopped        # Default: unless-stopped
