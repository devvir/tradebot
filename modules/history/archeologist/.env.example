# Archeaologist Module Configuration
# Copy this file to .env and update all credentials!

# ===== Infrastructure =====
DB_URL=${DB_STORE_URL}

# ===== Historian Service =====
HISTORIAN_DATABASE=tradebot_history               # Default: tradebot_history (target database)
HISTORIAN_PORT=                                   # Default: <empty> (random available port)
HISTORIAN_RESTART_POLICY=unless-stopped           # Default: unless-stopped
