# Collector Module Configuration
# Copy this file to .env and update all credentials!

# ===== Service Scaling ======
# BROADCAST_REPLICAS=1                      # Default: 1 (number of instances for horizontal scaling in Swarm)
# WRITER_REPLICAS=1                         # Default: 1 (number of instances for horizontal scaling in Swarm)

# ===== Broadcast Service =====
BROADCAST_MESSAGE_TTL=1800000             # Default: 1800000 (queue TTL, 30 minutes in ms)
BROADCAST_RECONNECT_DELAY_MS=5000         # Default: 5000 (initial reconnection delay to Bitmex WS)
BROADCAST_MAX_RECONNECT_DELAY_MS=60000    # Default: 60000 (max reconnection delay to Bitmex WS)
BROADCAST_PORT=                           # Default: <empty> (random port)
BROADCAST_RESTART_POLICY=unless-stopped   # Default: unless-stopped

# ===== Writer Service =====
WRITER_DB_ARCHIVE=tradebot_archive        # Default: tradebot_archive
WRITER_DB_COLLECT=tradebot_collect        # Default: tradebot_collect
WRITER_PREFETCH=1000                      # Default: 1000 (batch size to consume from rabbitmq)
WRITER_PORT=                              # Default: <empty> (random available port)
WRITER_RESTART_POLICY=unless-stopped      # Default: unless-stopped
