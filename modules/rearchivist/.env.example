# Rearchivist Module Configuration
# Copy this file to .env and update all credentials!

# ===== Service Scaling ======
READER_REPLICAS=1                           # Default: 1 (number of instances for horizontal scaling in Swarm)
CODEC_REPLICAS=1                            # Default: 1 (number of instances for horizontal scaling in Swarm)
WRITER_REPLICAS=1                           # Default: 1 (number of instances for horizontal scaling in Swarm)

# ===== Reader Service =====
READER_DATABASE=tradebot_archive            # Default: tradebot_archive (MongoDB database to read encoded data from)
READER_COLLECTIONS=                         # Default: <empty> (all collections; comma-separated whitelist)
READER_EXCHANGE=ex.transform                # Default: ex.transform (topic exchange reader publishes to)
READER_QUEUE=q.transform                    # Default: q.transform (subscribed to the all READER_EXCHANGE topics)
READER_BATCH_SIZE=1000                      # Default: 1000 (batch size for scanning MongoDB)
READER_POLL_INTERVAL_MS=3000                # Default: 3000 (interval from completion to next iteration)
READER_PORT=                                # Default: <empty> (random available port)
READER_RESTART_POLICY=unless-stopped        # Default: unless-stopped

# ===== Codec Service =====
CODEC_INBOUND_EXCHANGE=ex.codec.in          # Default: ex.codec.in (codec decompresses from reader)
CODEC_INBOUND_QUEUE=q.codec.in              # Default: q.codec.in
CODEC_OUTBOUND_EXCHANGE=ex.codec.out        # Default: ex.codec.out (output to writer for storage)
CODEC_OUTBOUND_QUEUE=q.codec.out            # Default: q.codec.out
CODEC_STRATEGY=                             # Default: <empty> (optional, comma-separated: encode, binary)
CODEC_PREFETCH=100                          # Default: 100 (number of messages buffered from queue)
CODEC_BROTLI_QUALITY=4                      # Default: 4 (compression quality 0-11: 0=fastest, 11=best compression)
CODEC_PORT=                                 # Default: <empty> (random available port)
CODEC_RESTART_POLICY=unless-stopped         # Default: unless-stopped

# ===== Writer Service =====
WRITER_DATABASE=                            # Default: <empty> (Required: MongoDB database to write decoded data to)
WRITER_EXCHANGE=ex.archive                  # Default: ex.archive (topic exchange writer consumes from)
WRITER_QUEUE=q.archive                      # Default: q.archive (subscribed to the all WRITER_EXCHANGE topics)
WRITER_BATCH_SIZE=1000                      # Default: 1000 (batch size to consume from rabbitmq)
WRITER_BATCH_TIMEOUT_MS=5000                # Default: 5000 (timeout for consuming from rabbitmq)
WRITER_PORT=                                # Default: <empty> (random available port)
WRITER_RESTART_POLICY=unless-stopped        # Default: unless-stopped
