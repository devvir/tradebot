# Rearchivist Module Configuration
# Copy this file to .env and update all credentials!

# ===== Reader Service =====
READER_DATABASE=                            # (required) MongoDB database to read encoded data from
READER_COLLECTIONS=                         # Default: <empty> (all collections; comma-separated whitelist)
READER_POLL_INTERVAL_MS=3000                # Default: 3000 (interval from completion to next iteration)
READER_PORT=                                # Default: <empty> (random available port)
READER_RESTART_POLICY=unless-stopped        # Default: unless-stopped

# ===== Codec Service =====
CODEC_PREFETCH=1000                         # Default: 1000 (number of messages buffered from queue)
CODEC_BROTLI_QUALITY=1                      # Default: 1 (compression quality 0-11: 0=fastest, 11=best compression)
CODEC_PORT=                                 # Default: <empty> (random available port)
CODEC_RESTART_POLICY=unless-stopped         # Default: unless-stopped

# ===== Writer Service =====
WRITER_PREFETCH=1000                        # Default: 1000 (batch size to consume from rabbitmq)
WRITER_PORT=                                # Default: <empty> (random available port)
WRITER_RESTART_POLICY=unless-stopped        # Default: unless-stopped
