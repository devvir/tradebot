# Replay Module — Exchange App
# Copy this file to .env and update configuration values.

# ===== Clock =====
DIGGER_START_TIME=2019-01-01T00:00:00Z   # Replay clock start. ISO-8601 or epoch ms. Frozen until a client subscribes.

# ===== Database (librarian) =====
DB_URL=                                  # MongoDB connection string
DB_DATABASE=tradebot

# ===== Scaling (firehose pools) =====
REPLAY_LIBRARIAN_REPLICAS=3              # stream-path librarian instances
REPLAY_PROVIDER_REPLICAS=3               # stream-path provider instances

# ===== Host port mappings (empty = random) =====
DIGGER_WS_PORT=8180                      # ws stream  (container :80)
DIGGER_REST_PORT=3101                    # rest api   (container :8000)
DIGGER_CONTROL_PORT=8280                 # control api (container :8001)

# ===== Tuning (optional) =====
# DIGGER_BATCH_SIZE=1000                 # provider read batch size
# DIGGER_LOW_WATERMARK=5000              # buffer refill threshold
# DIGGER_DRAIN_BATCH=256                 # messages emitted per event-loop turn
# DIGGER_BP_HIGH=4000000                 # backpressure pause threshold (bytes)
# DIGGER_BP_LOW=1000000                  # backpressure resume threshold (bytes)
