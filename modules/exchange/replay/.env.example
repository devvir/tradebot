# Replay Module — Exchange App
# Copy this file to .env and update configuration values.

# ===== Digger Service =====
DIGGER_WAIT_IF=                       # Default: <empty> (backpressure: queue:depth,queue:depth)
DIGGER_START_TIME=                    # Required: replay clock start. ISO-8601 or epoch ms (e.g. 2019-01-01T00:00:00Z)
DIGGER_LOW_WATERMARK=5000             # Default: 5000 (inbound buffers depth low watermark)
DIGGER_BATCH_SIZE=1000                # Default: 1000 (mongodb consumption batch size)
DIGGER_PORT=                          # Default: <empty> (random host port)

# ===== Rest Service =====
REST_DATA_URL=http://digger           # Default: http://digger (REST API backend)
REST_PORT=                            # Default: <empty> (random host port)

# ===== WS Service =====
WS_COMMANDS_URL=                      # Default; <empty> (digger service commands server)
WS_PORT=8180
