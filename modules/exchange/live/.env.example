# Live Module — Exchange App
# Copy this file to .env and update configuration values.

# ===== Broadcast Service =====
BROADCAST_FEED_PRESET=none                  # Default: none (subscribe via the Commands API)
BROADCAST_PORT=                             # Default: <empty> (random port)
BROADCAST_RESTART_POLICY=unless-stopped     # Default: unless-stopped

# ===== Snapshots Service =====
SNAPSHOTS_HTTP_PORT=                        # Default: <empty> (random host port)
SNAPSHOTS_HEALTH_PORT=                      # Default: <empty> (random health check port on host)
SNAPSHOTS_RESTART_POLICY=unless-stopped     # Default: unless-stopped

# ===== Proxy Service =====
PROXY_HTTP_PORT=                            # Default: <empty> (random host port; internal port is 80)
PROXY_HEALTH_PORT=                          # Default: <empty> (random health check port on host)
PROXY_RESTART_POLICY=unless-stopped         # Default: unless-stopped

# ===== Rest Service =====
REST_DATA_URL=                              # Default; <empty> (data backend URL)
REST_HTTP_PORT=                             # Default: <empty> (random host port)
REST_HEALTH_PORT=                           # Default: <empty> (random health check port on host)
REST_RESTART_POLICY=unless-stopped          # Default: unless-stopped

# ===== WS Service =====
SNAPSHOTS_URL=                              # Default; <empty> (snapshots service http server)
BROADCAST_URL=                              # Default; <empty> (broadcast service commands server)
WS_PORT=                                    # Default: <empty> (random websocket port on host)
WS_RESTART_POLICY=unless-stopped            # Default: unless-stopped
