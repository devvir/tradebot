# Exchange Module — Live
# Copy this file to .env and update configuration values.
# Provides a BitMEX-compatible WebSocket and REST API backed by live BitMEX data.

# ===== Broadcast Service =====
BROADCAST_MESSAGE_TTL=1800000             # Default: 1800000 (queue TTL, 30 minutes in ms)
BROADCAST_RECONNECT_DELAY_MS=5000         # Default: 5000 (initial reconnection delay to Bitmex WS)
BROADCAST_MAX_RECONNECT_DELAY_MS=60000    # Default: 60000 (max reconnection delay to Bitmex WS)
BROADCAST_PORT=                           # Default: <empty> (random port)
BROADCAST_RESTART_POLICY=unless-stopped   # Default: unless-stopped

# ===== Snapshots Service =====
SNAPSHOTS_PORT=                           # Default: <empty> (random host port)
SNAPSHOTS_HEALTH_PORT=                    # Default: <empty> (random health check endpoint on host)
SNAPSHOTS_RESTART_POLICY=unless-stopped   # Default: unless-stopped (Docker restart policy)

# ===== Rest Service =====
REST_HTTP_PORT=                           # Default: <empty> (random host port)
REST_HEALTH_PORT=                         # Default: <empty> (random host port)
REST_RESTART_POLICY=unless-stopped        # Default: unless-stopped (Docker restart policy)

# ===== WS Service =====
WS_PORT=8180                              # Default: 8180 (WebSocket server port on the host)
WS_RESTART_POLICY=unless-stopped          # Default: unless-stopped (Docker restart policy)

# ===== Shared (Rest / Ws) =====
SNAPSHOTS_URL=                            # Default: <empty> (must be provided by the module)