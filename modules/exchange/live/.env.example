# Live Module — Exchange App
# Copy this file to .env and update configuration values.

# ===== Broadcast Service =====
BROADCAST_FEED_PRESET=none                  # Default: none (subscribe via the Commands API)
BROADCAST_PORT=                             # Default: <empty> (random port)

# ===== Snapshots Service =====
SNAPSHOTS_PORT=                        # Default: <empty> (random host port)

# ===== Proxy Service =====
PROXY_PORT=                            # Default: <empty> (random host port; internal port is 80)

# ===== Rest Service =====
REST_DATA_URL=                              # Default; <empty> (data backend URL)
REST_PORT=                             # Default: <empty> (random host port)

# ===== WS Service =====
SNAPSHOTS_URL=                              # Default; <empty> (snapshots service http server)
BROADCAST_URL=                              # Default; <empty> (broadcast service commands server)
WS_PORT=                                    # Default: <empty> (random websocket port on host)

# ===== Trader Service =====
TRADER_ACCOUNT_ID=                          # Required: Bouncer account ID used to sign REST requests
TRADER_STRATEGY=range                       # Default: range (buy/sell 1% from mid)
TRADER_SYMBOL=XBTUSD                        # Default: XBTUSD
TRADER_TICK_INTERVAL_MS=30000               # Default: 30000 (30s between strategy ticks)
TRADER_WS_URL=                              # Default: ws://ws (internal WS service URL)
TRADER_REST_URL=                            # Default: http://rest (internal REST service URL)
