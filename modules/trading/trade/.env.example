# Archeaologist Module Configuration
# Copy this file to .env and update all credentials!


# ===== Bouncer Service =====
BOUNCER_HTTP_PORT=                            # Default: <empty> (random available port)
BOUNCER_HEALTH_PORT=                          # Default: <empty> (random available port)
BOUNCER_RESTART_POLICY=unless-stopped         # Default: unless-stopped

# ===== Executor Service =====
EXECUTOR_HTTP_PORT=                           # Default: <empty> (random available port)
EXECUTOR_HEALTH_PORT=                         # Default: <empty> (random available port)
EXECUTOR_RESTART_POLICY=unless-stopped        # Default: unless-stopped