# Trade Module Configuration
# Copy this file to .env and update all credentials!

# ===== Bouncer Service =====
BOUNCER_URL=http://bouncer:80             # Default: http://bouncer:80 (Bouncer internal URL)
BOUNCER_TOKEN=                            # Default: <empty> (Bouncer token, required, usually set in root .env)
BOUNCER_HTTP_PORT=7113                    # Default: 7113 (Bouncer HTTP port mapping on host)
BOUNCER_HEALTH_PORT=                      # Default: <empty> (random available port on host)
BOUNCER_RESTART_POLICY=unless-stopped     # Default: unless-stopped

# ===== Executor Service =====
EXECUTOR_HTTP_PORT=                       # Default: <empty> (random available port on host)
EXECUTOR_HEALTH_PORT=                     # Default: <empty> (random available port on host)
EXECUTOR_RESTART_POLICY=unless-stopped    # Default: unless-stopped
