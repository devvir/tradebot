# Trade Module Configuration
# Copy this file to .env and fill in credentials.

# ===== Endpoints =====
# Defaults point at the `ws` and `rest` services on the shared network
# (i.e. the exchange/live or exchange/replay module must be running).
# Override to point at BitMEX directly — the trader signs every request
# BitMEX-compatible, so the same code path works either way.
# TRADER_WS_URL=ws://ws
# TRADER_REST_URL=http://rest
# TRADER_WS_URL=wss://www.bitmex.com/realtime
# TRADER_REST_URL=https://www.bitmex.com

# ===== BitMEX Credentials =====
# api-key + api-secret of the BitMEX account being traded.
# Used both for HMAC signing and as the account identity through our proxy.
TRADER_API_KEY=                             # (required)
TRADER_API_SECRET=                          # (required)

# ===== Strategy =====
TRADER_STRATEGY=range                       # Strategy name from the registry
TRADER_SYMBOL=XBTUSD                        # Single symbol per process
TRADER_TICK_INTERVAL_MS=30000               # How often the strategy reconverges
