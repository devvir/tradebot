# Catalog Module Configuration
# Copy this file to .env and adjust.

# ===== Storage =====
# Host directory holding catalog.db, mounted at /data/catalog in the container.
# Pre-create it owned by uid 1000:
#   sudo mkdir -p /storage/tradebot/catalog && sudo chown 1000:1000 /storage/tradebot/catalog
#
# Defaults under the shared data root. Set an absolute path to put it elsewhere
# — another volume, another machine — without any service knowing, since the
# container path is fixed and private.
#
# Nothing is created but the database: point this somewhere empty and prospector
# builds a fresh catalog at the current schema on first start.
CATALOG_DIR=

# ===== Catalog API =====
# The shared secret every request carries in `x-catalog-token`.
#
# LEAVE IT EMPTY AND THE CHECK IS OFF: every request is let through, which is
# what makes the read endpoints answerable straight from a browser with no
# header to set. Suitable where nothing else can reach the port; prospector
# warns on startup so it cannot be the state nobody chose. Set it wherever the
# port is reachable from anywhere you do not control.
CATALOG_TOKEN=

# Host port the API is published on. Leave empty and docker assigns a free one,
# which is the right answer while everything that calls it shares the network.
# Set it when something outside has to reach the catalog at a known address.
CATALOG_PORT=

# ===== Prospector Service =====
PROSPECTOR_VENUES=                          # Default: <empty> (all). CSV of: binance,bybit,gate,htx,kucoin,okx
PROSPECTOR_CONCURRENCY=200                  # Default: 200. Requests in flight at once ACROSS EVERY VENUE — walking, mapping and probing alike. What one venue tolerates is a fact about that venue and lives in its adapter; this is the machine's own ceiling
