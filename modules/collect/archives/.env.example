# Archives Module Configuration
# Copy this file to .env and adjust.

# ===== Storage =====
# CATALOG_DIR is the host directory holding catalog.db, mounted at /data/catalog
# in the containers. Pre-create it owned by uid 1000:
#   sudo mkdir -p /storage/tradebot/catalog && sudo chown 1000:1000 /storage/tradebot/catalog
#
# The root .env sets it to ${DATA_DIR}/catalog. Set an absolute path here to
# put it elsewhere — another volume, another machine — without any service
# knowing, since the container path is fixed and private.
#
# Nothing is created but the database: point this somewhere empty and prospector
# builds a fresh catalog at the current schema on first start. Prospector and
# catalog both mount it, so they run on the same host.
# CATALOG_DIR=/storage/tradebot/catalog

# ===== Catalog API =====
# The shared secret every request carries in `x-catalog-token`, checked by both
# catalog and prospector.
#
# LEAVE IT EMPTY AND THE CHECK IS OFF: every request is let through, which is
# what makes the read endpoints answerable straight from a browser with no
# header to set. Both services warn on startup so it cannot be the state nobody
# chose. Set it whenever CATALOG_BIND lets another host reach the catalog.
#
# It does not guard catalog-ui: that adds the token to every request it
# forwards, so whoever reaches catalog-ui acts with it.
CATALOG_TOKEN=

# Host port the catalog API is published on; prospector publishes none. Empty
# still publishes it, on a free port docker picks. Set it when something has to
# reach the catalog at a known address.
CATALOG_PORT=
# Default: 127.0.0.1, so only this host connects. Set 0.0.0.0 only when another
# host must connect, and then set CATALOG_TOKEN too.
CATALOG_BIND=127.0.0.1

# ===== Catalog UI =====
# Host port the page is served on.
CATALOG_UI_PORT=9020
# Default: 127.0.0.1, so only this host opens the page. Set 0.0.0.0 only when
# another host must, and only where everyone who can reach it may act with
# CATALOG_TOKEN: start and pause surveys, and create, edit and delete lenses.
CATALOG_UI_BIND=127.0.0.1


# ===== Prospector Service =====
# Default: <empty> (all). CSV of: binance,bitget,bybit,gate,htx,kucoin,okx
PROSPECTOR_VENUES=
# Default: 200. Requests in flight at once ACROSS EVERY VENUE — walking, mapping
# and probing alike. What one venue tolerates is a fact about that venue and
# lives in its adapter; this is the machine's own ceiling. Requests go out
# through one transport worker per 1,000 of it, rounded up.
PROSPECTOR_CONCURRENCY=200

# ===== Hauler Service =====
# Walks each venue as a bucket the catalog serves — only files still owed — and
# writes them under DATA_ARCHIVES_DIR (the root .env's) at their canonical paths.
# Default: <empty> (every catalogued file). The slug of a catalog lens to haul
# through.
HAULER_LENS=
# Default: <empty> (every venue the catalog knows). CSV, e.g. binance,bitget
HAULER_VENUES=
# Default: 25. Nothing more is fetched while the archives volume has less free
# space than this, in GB.
HAULER_MIN_FREE_GB=25
# Default: 100. Concurrent fetches ACROSS EVERY VENUE — one budget for the link,
# shared by the venues walking.
HAULER_CONCURRENCY=100
