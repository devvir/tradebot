# Archives Module Configuration
# Copy this file to .env and adjust.

# ===== Storage =====
# Host directory holding catalog.db, mounted at /data/catalog in the containers.
# Pre-create it owned by uid 1000:
#   sudo mkdir -p /storage/tradebot/catalog && sudo chown 1000:1000 /storage/tradebot/catalog
#
# Defaults under the shared data root. Set an absolute path to put it elsewhere
# — another volume, another machine — without any service knowing, since the
# container path is fixed and private.
#
# Nothing is created but the database: point this somewhere empty and prospector
# builds a fresh catalog at the current schema on first start. Prospector and
# catalog both mount it, so they run on the same host.
CATALOG_DIR=

# ===== Catalog API =====
# The shared secret every request carries in `x-catalog-token`, checked by both
# catalog and prospector.
#
# LEAVE IT EMPTY AND THE CHECK IS OFF: every request is let through, which is
# what makes the read endpoints answerable straight from a browser with no
# header to set. Suitable where nothing else can reach the port; both services
# warn on startup so it cannot be the state nobody chose. Set it wherever the
# port is reachable from anywhere you do not control.
CATALOG_TOKEN=

# Host port the catalog API is published on; prospector publishes none. Leave
# it empty and docker assigns a free one, which is the right answer while
# everything that calls it shares the network. Set it when something outside has
# to reach the catalog at a known address.
CATALOG_PORT=

# ===== Catalog UI =====
# Host port the browser opens. Published by default, unlike the catalog's own —
# this is the one service in the module meant to be opened by a person.
CATALOG_UI_PORT=9020


# ===== Prospector Service =====
PROSPECTOR_VENUES=                          # Default: <empty> (all). CSV of: binance,bybit,gate,htx,kucoin,okx
PROSPECTOR_CONCURRENCY=200                  # Default: 200. Requests in flight at once ACROSS EVERY VENUE — walking, mapping and probing alike. What one venue tolerates is a fact about that venue and lives in its adapter; this is the machine's own ceiling. One transport worker per 1,000

# ===== Hauler Service =====
# Walks each venue as a bucket the catalog serves — only files still owed — and
# writes them under HAULER_ARCHIVES_DIR at their canonical paths.
HAULER_ARCHIVES_DIR=                        # REQUIRED. Host dir for the canonical archives; pre-create owned by uid 1000
HAULER_LENS=                                # Default: <empty> (every catalogued file). The slug of a catalog lens to haul through
HAULER_VENUES=                              # Default: <empty> (every venue the catalog knows). CSV, e.g. binance,bitget
HAULER_CONCURRENCY=8                        # Default: 8. Concurrent fetches PER VENUE — venues never wait on each other
