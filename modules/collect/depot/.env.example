# Depot Module Configuration
# Copy this file to .env and update all credentials!

# ===== Courier Service =====
COURIER_START_DATE=                         # Default: <empty> (sync from beginning). Format: yyyy-mm-dd

# ===== Scribe Service =====
SCRIBE_TABLES=                              # Default: <empty> (all tables); CSV of: compositeIndex,tick,funding,insurance,settlement
SCRIBE_START_DATE=                          # Default: <empty> (resume from last persisted state)
SCRIBE_INDEX_TICK_ONLY=true                 # Default: true (filter compositeIndex items by reference=BMI)
SCRIBE_IDENTITIES=                          # Default: <empty> (guest only, 180/min). CSV of apiKey:apiSecret — each BitMEX account adds a 120/min lane
SCRIBE_IN_FLIGHT=20                         # Default: 20. Max concurrent page fetches across the whole service (also each table's ring size)
SCRIBE_RATE_WATERLINE=100                   # Default: 100. Combined rate-limit budget below which the fetch loop starts pacing

# ===== Hauler Service =====
# What hauler fetches is a shopping list maintained over its own API, not env —
# see services/hauler/README.md. Everything below narrows a deployment's slice
# of that list; it never adds to it.
CATALOG_URL=                                # Default: http://prospector:8080. Where the catalog answers
CATALOG_TOKEN=                              # REQUIRED. The same secret the catalog module sets — opens the catalog AND hauler's own API
HAULER_ARCHIVES_DIR=                        # REQUIRED. Host dir for the canonical archives; pre-create owned by uid 1000
HAULER_CONCURRENCY=8                        # Default: 8. Concurrent fetches PER VENUE — venues never wait on each other
HAULER_VENUES=                              # Default: <empty> (every venue on the list). CSV, e.g. binance,bitget
HAULER_MARKETS=                             # Default: <empty> (every market on the list). CSV, canonical, e.g. spot,perp
HAULER_DATASETS=                            # Default: <empty> (every dataset on the list). CSV, canonical, e.g. klines,trades
HAULER_FROM=                                # Default: <empty> (no lower bound). yyyymm
HAULER_TO=                                  # Default: <empty> (no upper bound). yyyymm
HAULER_PORT=                                # Default: <empty> (docker picks). Host port for the shopping-list API

# ===== Tardy Service =====
TARDY_START_DATE=2023-03-30
TARDY_SUFFIX=                               # Optional. Write to its own namespace (<date>.<suffix>.csv.gz)
