# TradeBot — Environment Variables
# Copy this file to .env and fill in all required values.
#
# The QUEUE and CACHE sections name the infra packs (modules/infra) that define
# each service: local | store | market | bootcamp | shuttle
#
# Every published port has a *_BIND address beside it. Default: 127.0.0.1, so
# only this host connects. Set 0.0.0.0 only when another host must connect.
# An empty *_PORT still publishes, on a free port docker picks.

# === GLOBAL ===
APP_ENV=dev
NODE_ENV=${APP_ENV}
LOG_LEVEL=info
TZ=UTC

# === DOCKER ===
# Names the external network every module and pack joins: ${PROJECT_NAME}-network.
# Leave COMPOSE_PROJECT_NAME unset: it would override each compose file's own
# project name and merge every module and pack into one project.
PROJECT_NAME=tradebot

# ===== TradeBot Data Root =====
# Host data root (required). The directories below default under it; set one
# only to put it elsewhere. Compose refuses to start a service that mounts one
# while neither it nor DATA_DIR is set. Pre-create each owned by uid 1000.
DATA_DIR=
# The venue archives. Default: ${DATA_DIR}/archives
# DATA_ARCHIVES_DIR=/storage/tradebot/archives
# The directory holding catalog.db. Default: ${DATA_DIR}/catalog
# CATALOG_DIR=/storage/tradebot/catalog
# The Parquet vault stocker writes. Default: ${DATA_DIR}/vault
# DATA_VAULT_DIR=/storage/tradebot/vault

# === QUEUE ===
# Required, both. The brokers' user, created on their first start. Both are
# written into QUEUE_URL below as they are, so URL-safe characters only: none
# of @ : / # % ? and no spaces. A URL written by hand carries its credentials
# percent-encoded.
QUEUE_USER=
QUEUE_PASS=
# --- queue (packs: store, market, shuttle) ---
QUEUE_PORT=
QUEUE_BIND=127.0.0.1
QUEUE_MGMT_PORT=
QUEUE_MGMT_BIND=127.0.0.1
QUEUE_URL=amqp://${QUEUE_USER}:${QUEUE_PASS}@queue:5672
# --- queue-rt (packs: local, store, market, bootcamp) ---
QUEUE_RT_PORT=
QUEUE_RT_BIND=127.0.0.1
QUEUE_RT_MGMT_PORT=
QUEUE_RT_MGMT_BIND=127.0.0.1

# === CACHE: cache (packs: local, market) ===
# Required. Written into CACHE_URL as it is, so URL-safe characters only: none
# of @ : / # % ? and no spaces.
CACHE_PASS=
CACHE_PORT=
CACHE_BIND=127.0.0.1
CACHE_URL=redis://:${CACHE_PASS}@cache:6379
