# TradeBot — Environment Variables
# Copy this file to .env and fill in all required values.
#
# Each section is annotated with the infra packs (deployment roles) that use it:
#   local | store | market | bootcamp | shuttle
#
# Every published port has a *_BIND address beside it. Default: 127.0.0.1, so
# only this host connects. Set 0.0.0.0 only when another host must connect.
# An empty *_PORT still publishes, on a free port docker picks.

# === GLOBAL ===
APP_ENV=dev
NODE_ENV=${APP_ENV}
LOG_LEVEL=info
TZ=UTC

# === DOCKER ===
# Names the external network every module and pack joins: ${PROJECT_NAME}-network.
# Leave COMPOSE_PROJECT_NAME unset: it would override each compose file's own
# project name and merge every module and pack into one project.
PROJECT_NAME=tradebot

# ===== TradeBot Data Root =====
# Host data root (required). The directories below default under it.
DATA_DIR=
# The venue archives, shared by every service; pre-create owned by uid 1000.
DATA_ARCHIVES_DIR=${DATA_DIR}/archives
# The directory holding catalog.db; pre-create owned by uid 1000.
CATALOG_DIR=${DATA_DIR}/catalog
# The Parquet vault stocker writes; pre-create owned by uid 1000.
DATA_VAULT_DIR=${DATA_DIR}/vault

# ===== services/vault (raw dump service) =====
VAULT_PORT=1339
VAULT_BIND=127.0.0.1
# Default: 6. Integer 1 (fastest) – 9 (best compression).
VAULT_COMPRESSION_LEVEL=6

# === QUEUE ===
# Required, both. The broker's user, created on its first start. Both are
# written into the URLs below as they are, so URL-safe characters only: none of
# @ : / # % ? and no spaces.
QUEUE_USER=
QUEUE_PASS=
# --- Name: queue (roles: store, market, shuttle) ---
QUEUE_PORT=
QUEUE_BIND=127.0.0.1
QUEUE_MGMT_PORT=
QUEUE_MGMT_BIND=127.0.0.1
QUEUE_URL=amqp://${QUEUE_USER}:${QUEUE_PASS}@queue:5672
# --- Name: queue-rt (roles: local, store, market, bootcamp) ---
QUEUE_RT_PORT=
QUEUE_RT_BIND=127.0.0.1
QUEUE_RT_MGMT_PORT=
QUEUE_RT_MGMT_BIND=127.0.0.1
QUEUE_RT_URL=amqp://${QUEUE_USER}:${QUEUE_PASS}@queue-rt:5672

# === CACHE (roles: local, market) ===
# Required. Written into CACHE_URL as it is, so URL-safe characters only: none
# of @ : / # % ? and no spaces.
CACHE_PASS=
CACHE_PORT=
CACHE_BIND=127.0.0.1
CACHE_URL=redis://:${CACHE_PASS}@cache:6379
