# TradeBot — Environment Variables
# Copy this file to .env and fill in all required values.
#
# Each section is annotated with the infra packs (deployment roles) that use it:
#   local | store | market | bootcamp | shuttle

# === GLOBAL ===
APP_ENV=dev
NODE_ENV=${APP_ENV}
LOG_LEVEL=info
TZ=UTC

# === DOCKER ===
PROJECT_NAME=tradebot
COMPOSE_PROJECT_NAME=             # Override project name globally

# === BITMEX ===
BITMEX_TESTNET=true

# === BOUNCER (roles: local, store, market, bootcamp) ===
BOUNCER_PORT=1337
BOUNCER_URL=http://bouncer
BOUNCER_TOKEN=                                    # (required)

# === REGISTRY (roles: local, store) ===
REGISTRY_DATABASE=tradebot_registry
REGISTRY_URL=http://registry
REGISTRY_PORT=1338

# ===== Vault Service =====
VAULT_URL=http://vault
VAULT_PORT=1339
VAULT_DATA_DIR=/data/bitmex/vault                 # Directory on host machine (docker mount) to persist vault data
VAULT_COMPRESSION_LEVEL=6                         # Default: 6. Integer 1 (fastest) – 9 (best compression).

# === QUEUE ===
QUEUE_USER=                                       # (required)
QUEUE_PASS=                                       # (required)
# --- Name: queue (roles: local, store, market, shuttle) ---
QUEUE_PORT=
QUEUE_MGMT_PORT=
QUEUE_URL=amqp://${QUEUE_USER}:${QUEUE_PASS}@queue:5672
# --- Name: queue-rt (roles: local, store, market, bootcamp) ---
QUEUE_RT_PORT=
QUEUE_RT_MGMT_PORT=
QUEUE_RT_URL=amqp://${QUEUE_USER}:${QUEUE_PASS}@queue-rt:5672

# === DATABASE ===
DB_USER=                                          # (required)
DB_PASS=                                          # (required)
# --- Name: db-store (roles: store) ---
DB_STORE_PORT=
DB_STORE_CACHE_SIZE_GB=2
DB_STORE_URL=mongodb://${DB_USER}:${DB_PASS}@db-store?authSource=admin
# --- Name: db-replay (roles: bootcamp) ---
DB_REPLAY_PORT=
DB_REPLAY_CACHE_SIZE_GB=4
DB_REPLAY_URL=mongodb://${DB_USER}:${DB_PASS}@db-replay?authSource=admin
# --- Name: db-audit (roles: bootcamp) ---
DB_AUDIT_PORT=
DB_AUDIT_CACHE_SIZE_GB=2
DB_AUDIT_URL=mongodb://${DB_USER}:${DB_PASS}@db-audit?authSource=admin
# --- Name: db-store db-replay db-audit (local db aliases) ---
DB_PORT=
DB_CACHE_SIZE_GB=2

# === CACHE (roles: local, market) ===
CACHE_PASS=                                       # (required)
CACHE_PORT=
CACHE_URL=redis://:${CACHE_PASS}@cache:6379
