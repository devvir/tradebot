# TradeBot — Environment Variables
# Copy this file to .env and fill in all required values.
#
# Each section is annotated with the infra packs (deployment roles) that use it:
#   local | store | market | bootcamp | shuttle

# === GLOBAL ===
APP_ENV=dev
NODE_ENV=${APP_ENV}
LOG_LEVEL=info
TZ=UTC

# === DOCKER ===
PROJECT_NAME=tradebot
COMPOSE_PROJECT_NAME=             # Override project name globally

# === REGISTRY (roles: local, store) ===
REGISTRY_DATABASE=tradebot_registry
REGISTRY_URL=http://registry
REGISTRY_PORT=1338

# ===== TradeBot Data Root =====
DATA_DIR=                                         # Host data root
DATA_ARCHIVES_DIR=${DATA_DIR}/archives            # The venue archives, shared by every service; pre-create owned by uid 1000
DATA_VAULT_DIR=${DATA_DIR}/vault                  # The Parquet vault, shared by every service; pre-create owned by uid 1000

# ===== Vault Service =====
VAULT_URL=http://vault
VAULT_PORT=1339
VAULT_COMPRESSION_LEVEL=6                         # Default: 6. Integer 1 (fastest) – 9 (best compression).

# === QUEUE ===
QUEUE_USER=                                       # (required)
QUEUE_PASS=                                       # (required)
# --- Name: queue (roles: local, store, market, shuttle) ---
QUEUE_PORT=
QUEUE_MGMT_PORT=
QUEUE_URL=amqp://${QUEUE_USER}:${QUEUE_PASS}@queue:5672
# --- Name: queue-rt (roles: local, store, market, bootcamp) ---
QUEUE_RT_PORT=
QUEUE_RT_MGMT_PORT=
QUEUE_RT_URL=amqp://${QUEUE_USER}:${QUEUE_PASS}@queue-rt:5672

# === CACHE (roles: local, market) ===
CACHE_PASS=                                       # (required)
CACHE_PORT=
CACHE_URL=redis://:${CACHE_PASS}@cache:6379
