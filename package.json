{
  "name": "tradebot-monorepo",
  "version": "0.1.0",
  "description": "TradeBot: collect market data, normalise it, replay it",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.0"
  },
  "scripts": {
    "build": "pnpm --color -r build",
    "test": "vitest run && pnpm --color -r --no-bail --workspace-concurrency=1 test",
    "typecheck": "pnpm --color -r --if-present run typecheck",
    "check": "pnpm typecheck && pnpm knip",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.6",
    "knip": "^6.14.1",
    "nx": "22.6.3",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  },
  "packageManager": "pnpm@12.8.1"
}
