{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "**/.deprecated/**",
    ".github/skills/**"
  ],
  "ignoreWorkspaces": ["packages/*", "dx"],
  "ignoreBinaries": ["truncate"],
  "workspaces": {
    ".": {
      "entry": ["tsconfig.json"]
    },
    "services/**": {
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"]
    },
    "services/stocker": {
      "entry": ["src/index.ts", "src/containers/worker.ts"],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"]
    },
    "services/catalog-ui": {
      "entry": ["src/index.ts", "web/main.tsx", "vite.config.ts"],
      "project": ["src/**/*.ts", "web/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"]
    },
    "shared/**": {
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"],
      "includeEntryExports": true
    },
    "dev/tooling": {
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"]
    }
  },
  "ignoreExportsUsedInFile": true
}
