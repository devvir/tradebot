{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "**/.deprecated/**",
    ".github/skills/**",
    "services/prospector/src/scanners/none.ts"
  ],
  "ignoreWorkspaces": ["packages/*", "dx"],
  "ignoreBinaries": ["truncate"],
  "ignoreDependencies": ["nx"],
  "workspaces": {
    ".": {
      "entry": ["tsconfig.json"]
    },
    "services/**": {
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"]
    },
    "services/stocker": {
      "entry": ["src/containers/worker.ts"],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"]
    },
    "services/prospector": {
      "entry": ["src/transport.worker.ts"],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"]
    },
    "services/catalog-ui": {
      "project": ["src/**/*.ts", "web/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"]
    },
    "shared/**": {
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"],
      "includeEntryExports": true
    },
    "dev/tooling": {
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"]
    }
  },
  "ignoreExportsUsedInFile": true
}
