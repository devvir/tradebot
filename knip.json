{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "**/.deprecated/**",
    "dev/tooling/src/tools/cold/legacy/**",
    "dev/tooling/tests/tools/cold/legacy/**",
    ".github/skills/**"
  ],
  "ignoreWorkspaces": ["packages/*", "dx"],
  "ignoreBinaries": ["truncate"],
  "workspaces": {
    ".": {
      "entry": ["tsconfig.json"]
    },
    "services/**": {
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"]
    },
    "shared/**": {
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"]
    },
    "dev/tooling": {
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"]
    }
  },
  "ignoreExportsUsedInFile": true
}
