# Test environment for pipe integration tests.
# Services are started/stopped by the vitest globalSetup — do NOT rely on a live dev stack.

COMPOSE_PROJECT_NAME=pipe_test
TZ=UTC

# ── RabbitMQ ───────────────────────────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_AMQP_PORT=56732
