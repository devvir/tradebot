# Test environment for the pipe test suites.
# The integration project starts and stops RabbitMQ in its globalSetup; nothing relies on a live dev stack.

COMPOSE_PROJECT_NAME=pipe_test
TZ=UTC

# ── RabbitMQ ───────────────────────────────────────────────────────────────────
QUEUE_USER=guest
QUEUE_PASS=guest
RABBITMQ_AMQP_PORT=56732
RABBITMQ_MGMT_PORT=56733

# ── Pipe service ───────────────────────────────────────────────────────────────
QUEUE_URL=amqp://localhost
PIPE_BINDINGS=fanout:int.pipe.env.src > fanout:int.pipe.env.dst
