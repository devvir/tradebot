{
  "name": "@tradebot/pipe",
  "version": "1.0.0",
  "description": "Pipe service - native exchange-to-exchange bindings between RabbitMQ exchanges",
  "main": "dist/src/index.js",
  "private": true,
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/src/index.js",
    "dev": "ts-node src/index.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@devvir/service-kit": "workspace:*",
    "@tradebot/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "~22.20.5"
  }
}
