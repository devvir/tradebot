{
  "compilerOptions": {
    "target":                     "ES2020",
    "lib":                        ["ES2020", "DOM", "DOM.Iterable"],
    "types":                      ["vite/client", "vitest/globals", "@testing-library/jest-dom"],
    "module":                     "ESNext",
    "moduleResolution":           "bundler",
    "jsx":                        "react-jsx",
    "strict":                     true,
    "noUnusedLocals":             true,
    "noUnusedParameters":         true,
    "noImplicitReturns":          true,
    "skipLibCheck":               true,
    "allowImportingTsExtensions": true,
    "noEmit":                     true
  },
  "include": ["src", "tests"]
}
