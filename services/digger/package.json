{
  "name": "@tradebot/digger",
  "version": "1.0.0",
  "description": "Replay data pump — reads MongoDB collections and publishes to the replay exchange in WS message format",
  "main": "dist/index.js",
  "private": true,
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/src/index.js",
    "dev": "ts-node src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@devvir/bitmex-database": "^1.1.4",
    "@devvir/service-kit": "workspace:*",
    "@tradebot/types": "workspace:*",
    "@tradebot/utils": "workspace:*",
    "express": "^5.2.1",
    "mongodb": "^7.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0"
  }
}
