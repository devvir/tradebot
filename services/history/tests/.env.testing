# Test environment for history service tests.
# MongoDB is started/stopped by the vitest globalSetup — do NOT rely on a live dev stack.

COMPOSE_PROJECT_NAME=history_test
TZ=UTC

# ── MongoDB ────────────────────────────────────────────────────────────────────
MONGODB_USER=root
MONGODB_PASS=root
MONGODB_HOST=localhost
MONGODB_PORT=27027
MONGODB_CACHE_SIZE_GB=1

MONGODB_URL=mongodb://root:root@localhost:27027/test_history?authSource=admin
