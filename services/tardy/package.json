{
  "name": "@tradebot/tardy",
  "version": "1.0.0",
  "description": "Tardy service — downloads first-of-month BitMEX WebSocket history from Tardis and stores it in vault",
  "main": "dist/index.js",
  "private": true,
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/src/index.js",
    "dev": "ts-node src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@devvir/service-kit": "workspace:*",
    "@tradebot/utils": "workspace:*"
  }
}
