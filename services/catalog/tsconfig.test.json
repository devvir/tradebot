{
  "//": "Type-checks the tests together with the code they import, as vitest runs them (ESM). Never emits.",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  "include": ["src/**/*", "tests/**/*"]
}
