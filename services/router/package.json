{
  "name": "@tradebot/router",
  "version": "1.0.0",
  "description": "Router service - configurable message routing between RabbitMQ queues and exchanges",
  "main": "dist/src/index.js",
  "private": true,
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/src/index.js",
    "dev": "ts-node src/index.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@devvir/service-kit": "workspace:*",
    "@tradebot/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "~22.20.5"
  }
}
