# Test environment for router integration tests.
# Services are started/stopped by the vitest globalSetup — do NOT rely on a live dev stack.

COMPOSE_PROJECT_NAME=router_test
TZ=UTC

# ── RabbitMQ ───────────────────────────────────────────────────────────────────
QUEUE_USER=guest
QUEUE_PASS=guest
RABBITMQ_AMQP_PORT=56731
RABBITMQ_MGMT_PORT=56730

# ── Router service ─────────────────────────────────────────────────────────────
QUEUE_URL=amqp://localhost
ROUTER_RULES=broadcast > writer
