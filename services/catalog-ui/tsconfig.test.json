{
  "//": "Type-checks the tests together with the server and page code they import. Never emits.",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*", "tests/**/*", "web/**/*.ts", "web/**/*.tsx"]
}
