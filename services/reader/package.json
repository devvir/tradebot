{
  "name": "@tradebot/reader",
  "version": "1.0.0",
  "description": "Data replication service - exports archived data and streams real-time changes",
  "main": "dist/index.js",
  "private": true,
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "vitest run",
