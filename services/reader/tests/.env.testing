# Test environment for reader integration tests.
# Services are started/stopped by the vitest globalSetup — do NOT rely on a live dev stack.

COMPOSE_PROJECT_NAME=reader_test
TZ=UTC

# ── MongoDB ────────────────────────────────────────────────────────────────────
MONGODB_USER=root
MONGODB_PASS=root
MONGODB_HOST=localhost
MONGODB_PORT=
MONGODB_CACHE_SIZE_GB=1

# ── RabbitMQ ───────────────────────────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_AMQP_PORT=
RABBITMQ_MGMT_PORT=

MONGODB_URL=mongodb://localhost:27017/test
RABBITMQ_URL=amqp://localhost
READER_DATABASE=test
READER_POLL_INTERVAL_MS=500
