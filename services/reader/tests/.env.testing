# Test environment for writer/reader integration tests.
# Services are started/stopped by the vitest globalSetup — do NOT rely on a live dev stack.

COMPOSE_PROJECT_NAME=writer_test
TZ=UTC

# ── MongoDB ────────────────────────────────────────────────────────────────────
MONGODB_USER=root
MONGODB_PASS=root
MONGODB_HOST=localhost
MONGODB_PORT=27027
MONGODB_CACHE_SIZE_GB=1

# ── RabbitMQ ───────────────────────────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_AMQP_PORT=56729
