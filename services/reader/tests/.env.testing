# Test environment for reader integration tests.
# Services are started/stopped by the vitest globalSetup — do NOT rely on a live dev stack.

COMPOSE_PROJECT_NAME=reader_test
TZ=UTC

# ── MongoDB ────────────────────────────────────────────────────────────────────
DB_USER=root
DB_PASS=root
DB_CACHE_SIZE_GB=1

# ── RabbitMQ ───────────────────────────────────────────────────────────────────
QUEUE_USER=guest
QUEUE_PASS=guest
RABBITMQ_AMQP_PORT=
RABBITMQ_MGMT_PORT=

# ── Test Service Configuration ─────────────────────────────────────────────────
# Placeholder values — tests use actual ports from .ports.json (discovered by global-setup)
# These are only used to satisfy config validation at import time
DB_URL=mongodb://root:root@localhost:0/test?authSource=admin
QUEUE_URL=amqp://guest:guest@localhost:0
READER_DATABASE=test
READER_POLL_INTERVAL_MS=500
