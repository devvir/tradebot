# Patterns match from the context root: anything meant to match at any depth
# needs a `**/` prefix.

# Version control. The prod image copies each workspace package as it would be
# published, without what an ignore file of the package names (a .gitignore
# naming dist/ among them), so no .gitignore enters the context
**/.git
**/.gitignore
.gitattributes

# Environment & secrets
**/.env
**/.env.*
!**/.env.example

# Node.js artifacts (rebuilt inside the image, never taken from the host)
**/node_modules
**/dist
**/coverage
**/*.tsbuildinfo
**/.pnpm-store

# Build artifacts & caches
**/.turbo
**/.nx
**/vitest.config.*.timestamp*

# Python artifacts
**/.venv
**/__pycache__

# Retired code
**/.deprecated

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Documentation
docs/
README.md

# Development tools & config
.prettier*
.eslint*
.github/

# CI/CD
.gitlab-ci.yml
.travis.yml

# Other
TODO.md
LICENSE
