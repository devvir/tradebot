{
  "name": "@tradebot/utils",
  "version": "1.0.0",
  "description": "Shared utility functions for TradeBot services",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "testing": ["dist/testing/index.d.ts"]
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "private": true,
  "keywords": ["tradebot", "utils"],
  "dependencies": {
    "@devvir/service-kit": "workspace:*",
    "@devvir/rabbitmq": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "~22.20.5"
  }
}
